{
  "name": "xedu-client",
  "version": "2.0.0",
  "description": "专业的 Jupyter Notebook 桌面管理工具 - 重构版本",
  "main": "electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n api,renderer -c blue,green \"python3 scripts/dev_api_server.py\" \"npm run dev:renderer\"",
    "dev:renderer": "npx vite",
    "build": "npx vite build",
    "quality-gate": "node scripts/run_quality_gate.mjs",
    "install:scratch": "npm install --prefix scratch-editor",
    "build:scratch": "npm run build --prefix scratch-editor",
    "check:scratch-build": "node scripts/check_scratch_build.mjs",
    "check:python-syntax": "node scripts/check_python_syntax.mjs",
    "check:renderer-syntax": "node --check electron/main/main.js",
    "check:bundle": "node scripts/check_bundle_size.js",
    "test:student-shell": "node --test renderer/js/student-shell-contract.test.mjs",
    "test:scratch": "npm test --prefix scratch-editor",
    "preview": "npx vite preview",
    "clean": "rimraf build",
    "full-build": "npm run clean && build.bat",
    "start-api": "python3 backend/backend_main.py || python backend/backend_main.py",
    "test-api": "curl http://127.0.0.1:5123/api/health",
    "test:resources-inspection": "node --test renderer/js/resources/student-workspace-utils.test.js",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n renderer,electron -c green,magenta \"npm run dev:renderer\" \"electron .\"",
    "electron:build": "npm run build:scratch && npm run check:scratch-build && npm run build && electron-builder",
    "electron:build:release": "npm run build:scratch && npm run check:scratch-build && npm run build && electron-builder --config electron-builder.release.cjs",
    "electron:build:bundled-python-no-models": "npm run electron:build:portable:mac",
    "electron:build:portable:mac": "npm run build:scratch && npm run check:scratch-build && npm run build && electron-builder --config electron-builder.bundled-python-no-models.cjs --mac",
    "electron:build:portable:win": "npm run build:scratch && npm run check:scratch-build && npm run build && electron-builder --config electron-builder.bundled-python-no-models.win.cjs --win",
    "electron:build:minimal": "npm run electron:build:minimal:mac",
    "electron:build:minimal:mac": "npm run build:scratch && npm run check:scratch-build && npm run build && electron-builder --config electron-builder.minimal.cjs --mac",
    "electron:build:minimal:win": "npm run build:scratch && npm run check:scratch-build && npm run build && electron-builder --config electron-builder.minimal.win.cjs --win",
    "electron:build:external-python": "npm run electron:build:external-python:mac",
    "electron:build:external-python:mac": "npm run build:scratch && npm run check:scratch-build && npm run build && electron-builder --config electron-builder.external-python.cjs --mac",
    "electron:build:external-python:win": "npm run build:scratch && npm run check:scratch-build && npm run build && electron-builder --config electron-builder.external-python.cjs --win",
    "electron:build:external-python:win32": "npm run build:scratch && npm run check:scratch-build && npm run build && electron-builder --config electron-builder.external-python.win32.cjs --win",
    "electron:pack": "npm run build:scratch && npm run check:scratch-build && npm run build && electron-builder --dir"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.1.3",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "com.xeduclient",
    "productName": "XEdu Client",
    "compression": "maximum",
    "directories": {
      "output": "dist-final",
      "buildResources": "resources"
    },
    "files": [
      "build/**/*",
      "electron/main/**/*.js",
      "electron/preload/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": "scratch-editor/build",
        "to": "scratch-editor/build",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/tests",
          "!**/tests/**/*",
          "!**/__pycache__",
          "!**/__pycache__/**/*",
          "!**/.pytest_cache",
          "!**/.pytest_cache/**/*",
          "!**/checkpoint",
          "!**/checkpoint/**/*",
          "!sasu/zhangjiang-image-recognition-standard",
          "!sasu/zhangjiang-image-recognition-standard/**/*"
        ]
      },
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "checkpoint",
        "to": "checkpoint"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "resources/xedu-logo.ico",
        "to": "app.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xedu Client",
      "uninstallDisplayName": "Xedu Client Uninstall",
      "artifactName": "${productName}-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "2052",
      "installerIcon": "resources/xedu-logo.ico",
      "uninstallerIcon": "resources/xedu-logo.ico",
      "installerHeaderIcon": "resources/xedu-logo.ico"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "icon": "resources/xedu-logo.ico"
    },
    "mac": {
      "icon": "resources/xedu-logo.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "keywords": [
    "jupyter",
    "notebook",
    "lab",
    "electron",
    "desktop",
    "python",
    "data-science"
  ],
  "author": "XEdu Team",
  "license": "MIT",
  "overrides": {
    "lodash": "^4.18.1"
  }
}
