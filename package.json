{
  "name": "xedu-client",
  "version": "2.0.0",
  "description": "专业的 Jupyter Notebook 桌面管理工具 - 重构版本",
  "main": "electron-main.js",
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build && tauri build",
    "preview": "npx vite preview",
    "clean": "rimraf dist src-tauri/target",
    "full-build": "npm run clean && bash build.sh",
    "start-api": "python backend_api.py",
    "test-api": "curl http://localhost:5000/api/health",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.3",
    "concurrently": "^8.2.2",
    "electron": "^39.2.1",
    "electron-builder": "^26.0.12",
    "rimraf": "^5.0.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.xeduclient",
    "productName": "Xedu Client",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "frontend-dist/**/*",
      "backend_api.py",
      "src/backend/**/*",
      "electron-main.js",
      "index-electron.html",
      "app.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "jupyter",
    "notebook",
    "lab",
    "tauri",
    "electron",
    "desktop",
    "python",
    "data-science"
  ],
  "author": "XEdu Team",
  "license": "MIT"
}
