{
  "name": "jupyterlab-micropython",
  "version": "2.1.0",
  "description": "ESP32 MicroPython experiment workflow for XEdu Client",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/**/*",
    "style/**/*",
    "schema/**/*",
    "static/**/*",
    "package.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "node --test src/index.test.mjs"
  },
  "dependencies": {
    "@jupyterlab/application": "~4.5.9",
    "@jupyterlab/apputils": "~4.6.9",
    "@jupyterlab/coreutils": "~6.5.9",
    "@jupyterlab/launcher": "~4.5.9",
    "@lumino/widgets": "^2.3.1"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.5.10"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab_micropython/labextension"
  }
}
